# Supabase media + config storage (reuses the shared project from vault/inkwell).
# The anon key is meant to be public (client-side) — safe to ship to the browser.
# Copy to .env (gitignored) for local dev, and add the same vars in Vercel.
#
# Find these in Supabase → Project Settings → API
# (same values as vault/inkwell's NEXT_PUBLIC_SUPABASE_URL + anon key).

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional — bucket name (default: hub-media). See SUPABASE.md to create it.
VITE_SUPABASE_BUCKET=hub-media
