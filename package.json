{
  "name": "sim-hub",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Sim Hub — an OBS-friendly recording app: typed-animation recreations of everyday apps, deployed on Vercel.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "local": "vite build && node server.mjs",
    "serve": "node server.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
